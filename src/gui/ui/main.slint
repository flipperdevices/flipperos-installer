// The FlipperOS installer window for the Flipper One 256x144 DRM/KMS screen.
//
// Three fonts, matching Flipper's own role split: HaxrCorp 4090 for values,
// status and titles; Busy9px for normal menu labels; Born2bSportyV2 (heavier)
// for the selected/active label. All three are pixel fonts with a 16px native
// size, so the UI is pinned to 16px to keep them crisp. Importing them embeds
// the .ttf in the binary and registers the family, so rendering uses these
// exact pixel glyphs (not a fontconfig substitute). Paths are relative to this
// file.
//
// NOTE: embedding does NOT free the runtime from fonts. Slint's LinuxKMS backend
// uses the `fontique` font engine, which links libfontconfig and panics at
// startup (fontique fontconfig backend, NoMatch) if fontconfig resolves zero
// fonts. So the initramfs MUST ship libfontconfig/libfreetype, a fonts.conf
// pointing at a font dir, and at least one font — shipping these three TTFs
// there is sufficient (they satisfy the engine and match these families).
import "../../../third_party/flipctl-fonts/HaxrCorp4090-FlipCTL/HaxrCorp4090-FlipCTL.ttf";
import "../../../third_party/flipctl-fonts/Busy9px-FlipCTL/Busy9px-FlipCTL.ttf";
import "../../../third_party/flipctl-fonts/Born2bSportyV2-FlipCTL/Born2bSportyV2-FlipCTL.ttf";

import { OutlineFrame, ProgressBar, ScrollBar, DarkTab } from "widgets.slint";
import { ListRow, MenuRow, SoftButton } from "rows.slint";

// One row of the summary screen or of the open menu level. Built by
// `core::menu` and handed over whole, so this file never has to know what a
// particular list contains — which is what lets one block render every level,
// however deep the operator has drilled.
export struct MenuEntry {
    text: string,
    detail: string,
    // Source glyph: 0 none, 1 network, 2 sdcard.
    icon: int,
    // Leading state marker: 0 none, 1 unchecked, 2 checked. Only multi-choice
    // levels use it; a single choice shows as where the cursor opens.
    marker: int,
    // Opens another level (drawn with a trailing chevron).
    drill: bool,
    dim: bool,
    // Summary rows only: the plain Install-style row, with no value chip.
    action: bool,
}

export component MainWindow inherits Window {
    // The Flipper One panel is a fixed 256x144 DRM/KMS device.
    width: 256px;
    height: 144px;
    background: #ffffff;
    default-font-family: "HaxrCorp 4090";
    // HaxrCorp 4090 is a pixel font whose design pixel is 64 font units
    // (1024 units/em), so it is only crisp at an integer multiple of its
    // 16px native size. Rendering it smaller (e.g. 8px) antialiases every
    // glyph into an illegible blur, so we pin it to 16px.
    default-font-size: 16px;
    title: "FlipperOS Installer";

    // Row height for submenu lists and how many rows are visible at once.
    // Compact 13px rows, matching FlipCTL's info-packed screens (Wi-Fi
    // settings, saved/visible networks) rather than the 20px MenuLine used
    // for icon menus. More builds on screen at once, no per-row icons.
    property <length> row-h: 13px;
    property <int> visible-rows: 8;

    // Soft-button geometry. The five FlipCTL keys (Escape, View, Power,
    // Edit, Run) sit at fixed positions under the screen, so their on-screen
    // tabs are fixed-width and pinned to five evenly-spaced slots: slot 0
    // flush left, slot 4 flush right. `sb-x(i)` is the left edge of slot i.
    property <length> sb-w: 48px;
    pure function sb-x(slot: int) -> length {
        return slot * (root.width - root.sb-w) / 4;
    }

    // --- inputs from Rust (shared state) ---
    // "Device type: <model> [<id>]" for the header's second line.
    in property <string> device-type-text;
    // Idle summary line, e.g. "3 targets, 14 builds found".
    in property <string> info-text;
    // Latest activity-log line, shown under the progress bar while running.
    in property <string> status-text;
    in property <float> progress;
    // Whether the Install soft button is live. The Install *row*'s own value
    // ("ready" / "in progress" / "incomplete") arrives with `summary-items`.
    in property <bool> can-install;
    // True once an install has succeeded for real (never in a dry run), which is
    // when the RUN slot stops offering Install and offers Reboot instead.
    in property <bool> can-reboot;
    // True once installation has started; gates the progress bar + log line
    // (which replace the idle info line).
    in property <bool> installing;
    // True while discovery or an install is running (Phase::is_busy). Hides
    // the Refresh soft button — re-scanning mid-run makes no sense.
    in property <bool> busy;

    // The summary screen's rows (exactly five: the screen has no room for a
    // sixth) and the rows of whichever level is open. Both come from
    // `core::menu`, which also decides their markers, chevrons and values.
    in property <[MenuEntry]> summary-items;
    in property <[MenuEntry]> level-items;
    // Heading tab of the open level.
    in property <string> level-title;
    // The level's rows are toggles, so confirming keeps it open.
    in property <bool> level-multi;
    // Whether the highlighted row has a details popup, and whether this level
    // can be re-fetched. Both replace what used to be hardcoded section checks.
    in property <bool> level-can-details;
    in property <bool> level-can-refresh;

    // Details popup (screen 2): sourcestamps for the highlighted build,
    // pre-wrapped into display lines for line-based scrolling.
    in property <string> details-title;
    in property <[string]> details-model;

    // --- actions back to Rust ---
    // Activate a row of the summary (screen 0) or the open level (screen 1) by
    // index. Rust performs the action AND moves its navigation stack, then
    // pushes the new level's rows back through `level-items`.
    callback activate(int);
    // Leave the open level. Rust pops one frame, restores that level's cursor,
    // and sets `screen` back to 0 once the stack is empty.
    callback back();
    callback start-install();
    // Close the installer and reboot the board (the RUN soft button once an
    // install has finished). Rust tears both frontends down first, so the serial
    // console is left in a usable state.
    callback reboot();
    // Re-query the bundle bucket / image server / removable media (the Edit
    // soft button). Mirrors the TUI's Refresh action.
    callback refresh();
    // Open the details popup for the highlighted row of the open level.
    callback show-details(int);
    // Per-keypress trace (text, screen, menu-index, cursor) for input
    // debugging. Only wired by Rust when `--debug-keys` is set — otherwise it
    // is a no-op, so nothing hits stderr / the shared console.
    callback trace-key(string, int, int, int);
    // Ask Rust to start whatever lazy fetch the rows now on screen need:
    // (first-row, count). Fired when a level opens and as it scrolls.
    callback ensure-visible(int, int);

    // --- navigation state ---
    // screen: 0 = summary, 1 = level popup, 2 = details popup. Exposed as
    // in-out so an off-device screenshot harness can drive the view; on-device
    // it is set by the keys and by Rust when the level stack empties.
    in-out property <int> screen: 0;
    // Highlighted summary row.
    in-out property <int> menu-index: 0;
    // Highlighted row of the open level. Kept here rather than in Rust so an
    // arrow key never has to round-trip through the controller; Rust reads it
    // when a row is activated and rewrites it when a level is entered or left.
    in-out property <int> cursor: 0;
    // Scroll offset (in rows) for the details popup on screen 2.
    in-out property <int> details-scroll: 0;

    function level-count() -> int { return root.level-items.length; }
    // First visible row, chosen so the cursor stays on screen.
    function sub-offset() -> int {
        return min(max(root.cursor - root.visible-rows + 1, 0),
                   max(root.level-count() - root.visible-rows, 0));
    }
    // --- level popup geometry (a modal over the dimmed summary) ---
    // Rows the popup shows at once: the whole list until it exceeds the cap.
    function popup-rows() -> int { return min(root.level-count(), root.visible-rows); }
    // List-body frame height: visible rows + 2px top / 1px bottom inner pad.
    function popup-frame-h() -> length { return popup-rows() * root.row-h + 3px; }
    // Frame top y. The tab overhangs ~14px above the frame; centre the whole
    // tab+frame block in the area above the 14px soft-button bar.
    function popup-frame-y() -> length {
        return (root.height - 14px - 14px - popup-frame-h()) / 2 + 14px;
    }
    // Rows visible at once in the details popup (screen 2), at the 14px pitch.
    function details-visible() -> int { return 7; }

    forward-focus: fs;
    fs := FocusScope {
        width: 100%;
        height: 100%;
        key-pressed(event) => {
            // Trace every key the backend delivers, before any matching, so
            // an operator can tell "libinput delivered nothing" (no events at
            // all) apart from "delivered the wrong text". Routed to Rust so it
            // only prints under `--debug-keys`; unwired it is a no-op (no
            // stderr output to garble the TUI on the shared kernel console).
            root.trace-key(event.text, root.screen, root.menu-index, root.cursor);

            // Input model:
            //   D-pad Up/Down  — move the selection
            //   ENTER (centre) — confirm the current action
            //   BACKSPACE      — go back (dedicated back key)
            // The five soft action buttons keep their conventional meanings;
            // the two used here are RUN (B = execute/start) and EXIT
            // (Z = cancel/stop). Confirm and back live on ENTER/BACKSPACE, so
            // they never depend on a soft button. Escape/Left are kept as
            // conveniences for desktop testing against a vkms device.

            // Back / exit. From a level this asks Rust to pop one frame: the
            // stack lives there (Slint has no growable state), and Rust sets
            // `screen` back to 0 once the last level has been left.
            if (event.text == Key.Backspace || event.text == Key.Escape
                || event.text == "z" || event.text == "Z") {
                if (root.screen == 2) { root.screen = 1; }
                else if (root.screen == 1) { root.back(); }
                return accept;
            }

            // Details popup (screen 2): scroll only.
            if (root.screen == 2) {
                if (event.text == Key.UpArrow) {
                    if (root.details-scroll > 0) { root.details-scroll -= 1; }
                    return accept;
                }
                if (event.text == Key.DownArrow) {
                    if (root.details-scroll < max(0, root.details-model.length - root.details-visible())) {
                        root.details-scroll += 1;
                    }
                    return accept;
                }
                return reject;
            }

            // RUN (B): the dedicated execute button. Starts the install from
            // the summary — or reboots, once one has finished; confirms the
            // current row inside a level. The dispatch tests the same property
            // as the soft button's caption, so key and label cannot disagree.
            if (event.text == "b" || event.text == "B") {
                if (root.screen == 0) {
                    if (root.can-reboot) { root.reboot(); }
                    else { root.start-install(); }
                }
                else { root.activate(root.cursor); }
                return accept;
            }

            // VIEW (X): open the details popup, when the highlighted row has
            // one (the core decides, so it works at any depth).
            if (event.text == "x" || event.text == "X") {
                if (root.screen == 1 && root.level-can-details) {
                    root.show-details(root.cursor);
                    root.details-scroll = 0;
                    root.screen = 2;
                }
                return accept;
            }

            // EDIT (V): re-query the sources. Available on the summary and on
            // any level that lists fetched data. Suppressed while discovery /
            // an install is running, matching where the soft button is shown.
            if ((event.text == "v" || event.text == "V") && !root.busy
                    && (root.screen == 0
                        || (root.screen == 1 && root.level-can-refresh))) {
                root.refresh();
                return accept;
            }

            if (root.screen == 0) {
                // Wrap-around at both ends, like the FlipCTL menus.
                if (event.text == Key.UpArrow) {
                    root.menu-index = root.menu-index > 0
                        ? root.menu-index - 1
                        : max(root.summary-items.length - 1, 0);
                    return accept;
                }
                if (event.text == Key.DownArrow) {
                    root.menu-index = root.menu-index < root.summary-items.length - 1
                        ? root.menu-index + 1
                        : 0;
                    return accept;
                }
                if (event.text == Key.Return) {
                    // Rust decides whether this row installs, opens a level or
                    // does nothing, and sets `screen` accordingly.
                    root.activate(root.menu-index);
                    return accept;
                }
                return reject;
            } else {
                if (event.text == Key.LeftArrow) { root.back(); return accept; }
                // Wrap-around at both ends, like the FlipCTL menus. After each
                // move, start whatever the now-visible rows need fetched.
                if (event.text == Key.UpArrow) {
                    root.cursor = root.cursor > 0
                        ? root.cursor - 1
                        : max(root.level-count() - 1, 0);
                    root.ensure-visible(root.sub-offset(), root.visible-rows);
                    return accept;
                }
                if (event.text == Key.DownArrow) {
                    root.cursor = root.cursor < root.level-count() - 1
                        ? root.cursor + 1
                        : 0;
                    root.ensure-visible(root.sub-offset(), root.visible-rows);
                    return accept;
                }
                if (event.text == Key.Return) {
                    root.activate(root.cursor);
                    return accept;
                }
                return reject;
            }
        }

        // ===== SUMMARY SCREEN =====
        // Rendered for the submenu (screen 1) too, so it shows (dimmed) behind
        // the submenu popup. Its own soft-button bar is gated to screen 0.
        if root.screen == 0 || root.screen == 1 : VerticalLayout {
            width: 100%;
            height: 100%;

            VerticalLayout {
                vertical-stretch: 1;
                padding: 3px;
                padding-bottom: 0px;
                spacing: 1px;

            Text {
                text: "FlipperOS Installation";
                color: #000000;
            }
            Text {
                text: root.device-type-text;
                color: #000000;
                overflow: elide;
            }
            Rectangle { height: 1px; background: #000000; }

            // The five summary rows, as built by `core::menu::root_level`.
            // Five is the ceiling: the header, rule and status line leave room
            // for exactly this many 16px rows on a 144px panel.
            for entry[i] in root.summary-items : MenuRow {
                label: entry.text;
                value: entry.detail;
                dim-value: entry.dim;
                action: entry.action;
                selected: root.menu-index == i;
            }

            Rectangle { vertical-stretch: 1; }

            // Idle: a one-line summary. Running: progress bar + latest log.
            if !root.installing : Text {
                text: root.info-text;
                color: #8c8c8c;
                overflow: elide;
            }
            // The bar is only shown while the run is in flight. Once it has
            // ended, the status line ("installation complete", or the failure)
            // stands in for the info line on its own — a 6px bar plus its
            // spacing needs 7px the panel does not have once the soft buttons
            // are back on screen, and the layout would take those pixels out of
            // the 14px button bar, clipping the tabs.
            if root.installing && root.busy : ProgressBar { progress: root.progress; }
            if root.installing : Text {
                text: root.status-text;
                color: #8c8c8c;
                overflow: elide;
            }
            }

            // Soft-button bar: fixed-width tabs on physical-button slots.
            // Refresh = Edit (slot 3), Install = Run (slot 4). Refresh drops
            // out while busy (discovery/install), leaving its slot empty.
            // Hidden while a submenu popup is open (screen 1).
            //
            // The RUN slot is Install until a run starts (which blanks it), then
            // Reboot once one has succeeded — the operator's next step, and the
            // only way to end the session from the device.
            if root.screen == 0 : Rectangle {
                height: 14px;
                if !root.busy : SoftButton {
                    x: root.sb-x(3); width: root.sb-w; caption: "Refresh";
                }
                SoftButton {
                    x: root.sb-x(4); width: root.sb-w;
                    caption: root.can-reboot ? "Reboot" : (root.installing ? "" : "Install");
                    primary: true;
                    enabled: root.can-reboot || root.can-install;
                }
            }
        }

        // ===== SUBMENU POPUP (screen 1) =====
        // A modal list floating over the dimmed summary, styled like the Wi-Fi
        // "Visible networks" popup: a dark heading tab, a white rounded body
        // frame sized to the visible rows, inset row dividers, and a scrollbar
        // in the right gutter. The summary renders behind (see its condition)
        // beneath a semi-transparent wash.
        if root.screen == 1 : Rectangle {
            width: 100%;
            height: 100%;

            // Semi-transparent wash dimming the summary behind the popup.
            Rectangle { background: #ffffffcc; }

            // White body frame, sized to the number of visible rows.
            OutlineFrame {
                x: 4px;
                y: root.popup-frame-y();
                width: 248px;
                height: root.popup-frame-h();
                filled: true;
                fill: #ffffff;
                clip: true;

                // One block for every level, however deep: the rows carry their
                // own markers, icons and chevrons.
                VerticalLayout {
                    x: 2px;
                    width: parent.width - 4px;
                    y: 2px - root.sub-offset() * root.row-h;
                    for entry[idx] in root.level-items : ListRow {
                        text: entry.text;
                        detail: entry.detail;
                        icon-kind: entry.icon;
                        marker: entry.marker;
                        drill: entry.drill;
                        dim: entry.dim;
                        selected: idx == root.cursor;
                    }
                }
            }

            // Scrollbar in the frame's right gutter (collapses when it fits).
            ScrollBar {
                x: 4px + 248px - 5px;
                y: root.popup-frame-y() + 2px;
                height: root.popup-frame-h() - 4px;
                total: root.level-count();
                visible-count: root.visible-rows;
                offset: root.sub-offset();
            }

            // Dark heading tab, overhanging above the frame's top-left corner
            // (its bottom merges into the frame's top border, clear of row 1).
            DarkTab {
                x: 6px;
                y: root.popup-frame-y() - 14px;
                caption: root.level-title;
            }

            // Soft-button bar (kept for discoverability), over the wash.
            // Back = Escape (0), Details = View (1), Refresh = Edit (3),
            // Select/Toggle = Run (4).
            Rectangle {
                x: 0px;
                y: parent.height - 14px;
                width: parent.width;
                height: 14px;
                SoftButton { x: root.sb-x(0); width: root.sb-w; caption: "Back"; }
                if root.level-can-details : SoftButton {
                    x: root.sb-x(1); width: root.sb-w; caption: "Details";
                }
                if (!root.busy && root.level-can-refresh) : SoftButton {
                    x: root.sb-x(3); width: root.sb-w; caption: "Refresh";
                }
                SoftButton {
                    x: root.sb-x(4); width: root.sb-w;
                    caption: root.level-multi ? "Toggle" : "Select";
                    primary: true;
                }
            }
        }

        // ===== DETAILS POPUP (screen 2) =====
        if root.screen == 2 : VerticalLayout {
            width: 100%;
            height: 100%;

            VerticalLayout {
                vertical-stretch: 1;
                padding: 3px;
                padding-bottom: 0px;
                spacing: 2px;

                // Heading tab — a 16px header like the reference popup's
                // TabHeader, carrying the build's detail title.
                OutlineFrame {
                    height: 16px;
                    Text {
                        x: 6px;
                        y: 0px;
                        height: parent.height;
                        text: root.details-title;
                        font-family: "HaxrCorp 4090";
                        color: #000000;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }

                // Bordered, scrolling text panel. Roomier than before: 3px
                // inner padding and a 14px line pitch (vs the old crammed
                // 12px) so the sourcestamps read like the reference popup.
                OutlineFrame {
                    clip: true;
                    vertical-stretch: 1;
                    VerticalLayout {
                        width: 100%;
                        padding: 3px;
                        y: -root.details-scroll * 14px;
                        for line[i] in root.details-model : Text {
                            height: 14px;
                            text: line;
                            font-family: "HaxrCorp 4090";
                            color: #000000;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                    }
                }
            }

            // Soft-button bar — Back on the Escape slot, matching the others.
            Rectangle {
                height: 14px;
                SoftButton { x: root.sb-x(0); width: root.sb-w; caption: "Back"; }
            }
        }
    }
}
